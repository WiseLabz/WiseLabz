{
  "race": {
    "data": {
      "packages": ["./internal/store", "./internal/backup", "./cmd/backup", "./internal/doc", "./internal/docexport", "./internal/quality", "./internal/sync/...", "./internal/notifications/...", "./internal/retention", "./internal/mcp"]
    },
    "api": {
      "packages": ["./internal/api", "./internal/api/runbooks", "./internal/api/docs", "./internal/api/connectors", "./internal/api/topology", "./internal/api/auth"]
    },
    "other": {
      "packages": ["./internal/auth", "./internal/config", "./internal/connector/...", "./internal/crypto", "./internal/httputil", "./internal/httpx", "./internal/ai", "./internal/report", "./internal/ttlcache", "./internal/compliance", "./internal/ws/...", "./internal/api/...", "./internal/topology", "./internal/scheduler", "./internal/health", "./internal/chat", "./internal/diagnostics", "./cmd/server"],
      "exclude": ["./internal/api", "./internal/api/runbooks", "./internal/api/docs", "./internal/api/connectors", "./internal/api/topology", "./internal/api/auth"]
    }
  },
  "postgres": {
    "b-g": {
      "packages": ["./internal/store/..."],
      "pattern": "^Test[B-G]"
    },
    "h-re": {
      "packages": ["./internal/store/..."],
      "pattern": "^Test([H-Q]|Re)"
    },
    "rest": {
      "packages": ["./internal/store/..."],
      "rest": true
    },
    "backup": {
      "packages": ["./internal/backup"]
    },
    "leader-retention": {
      "packages": ["./internal/leader", "./internal/retention"]
    }
  }
}
