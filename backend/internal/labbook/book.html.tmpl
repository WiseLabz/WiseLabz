<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; base-uri 'none'"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Lab Book</title>
<style>body{font:16px/1.6 system-ui,sans-serif;color:#18202b;max-width:1100px;margin:2rem auto;padding:0 1rem}a{color:#135ca8}nav ul{list-style:none;padding-left:1.3rem}article{border-top:1px solid #ccc;padding-top:1rem;margin-top:2rem}img,svg{max-width:100%;height:auto}pre{overflow:auto;background:#f3f4f6;padding:1rem}table{border-collapse:collapse;display:block;overflow:auto}td,th{border:1px solid #aaa;padding:.4rem}h1,h2,h3{break-after:avoid}section,article{break-inside:auto}@media print{body{max-width:none;margin:0;color:#000;font-size:11pt}nav{display:none}article{break-before:page}pre{white-space:pre-wrap;overflow:visible}table{display:table;width:100%}img,svg{break-inside:avoid}a{color:inherit;text-decoration:none}}</style></head>
<body><h1>Lab Book</h1><nav aria-label="Table of contents"><ul>{{template "toc" .Nodes}}</ul></nav>
{{template "articles" .Nodes}}
<script>{{.Mermaid}}</script>
<script>document.querySelectorAll('pre > code.language-mermaid').forEach(code => { const pre=code.parentElement; pre.className='mermaid'; pre.textContent=code.textContent; }); mermaid.initialize({startOnLoad:false,securityLevel:'strict',theme:'default'}); mermaid.run({querySelector:'.mermaid'}).catch(()=>{});</script>
</body></html>
{{define "toc"}}{{range .}}<li>{{if .ID}}<a href="#{{.ID}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .Children}}<ul>{{template "toc" .Children}}</ul>{{end}}</li>{{end}}{{end}}
{{define "articles"}}{{range .}}{{if .ID}}<article id="{{.ID}}"><h2>{{.Title}}</h2>{{.HTML}}{{if .Files}}<p>Attachments:</p><ul>{{range .Files}}<li>{{.}}</li>{{end}}</ul>{{end}}</article>{{end}}{{template "articles" .Children}}{{end}}{{end}}
